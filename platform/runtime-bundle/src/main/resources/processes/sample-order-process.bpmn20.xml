<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             targetNamespace="http://oop.com/sample">

  <process id="sampleOrderProcess" name="Sample Order Process" isExecutable="true">

    <startEvent id="start" name="Order Received"/>

    <sequenceFlow id="flow1" sourceRef="start" targetRef="validateOrder"/>

    <serviceTask id="validateOrder" name="Validate Order"
                 activiti:delegateExpression="${orderValidationConnector}"/>

    <sequenceFlow id="flow2" sourceRef="validateOrder" targetRef="reviewOrder"/>

    <userTask id="reviewOrder" name="Review Order"
              activiti:candidateGroups="operator"/>

    <sequenceFlow id="flow3" sourceRef="reviewOrder" targetRef="processPayment"/>

    <serviceTask id="processPayment" name="Process Payment"
                 activiti:delegateExpression="${processPaymentConnector}"/>

    <sequenceFlow id="flow4" sourceRef="processPayment" targetRef="shipOrder"/>

    <serviceTask id="shipOrder" name="Ship Order"
                 activiti:delegateExpression="${shipOrderConnector}"/>

    <sequenceFlow id="flow5" sourceRef="shipOrder" targetRef="end"/>

    <endEvent id="end" name="Order Fulfilled"/>

  </process>

</definitions>
